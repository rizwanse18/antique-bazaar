import Link from "next/link";
import { Search, ArrowRight, Gavel, Shield, Truck, BadgeCheck, Star, TrendingUp, MapPin } from "lucide-react";
import { prisma } from "@/lib/prisma";
import { formatPrice } from "@/lib/utils";
import AuctionCountdown from "@/components/listing/AuctionCountdown";
import WishlistButton from "@/components/listing/WishlistButton";

const CATEGORIES = [
  { name: "Furniture", slug: "furniture" },
  { name: "Paintings", slug: "paintings" },
  { name: "Coins", slug: "coins" },
  { name: "Jewelry", slug: "jewelry" },
  { name: "Ceramics", slug: "ceramics" },
  { name: "Watches", slug: "watches" },
  { name: "Textiles", slug: "textiles" },
  { name: "Sculpture", slug: "sculpture" },
];

async function getData() {
  const featured = await prisma.listing.findMany({
    where: { status: "APPROVED" },
    orderBy: { createdAt: "desc" },
    take: 12,
    include: { seller: { select: { name: true } } },
  });
  const auctions = await prisma.listing.findMany({
    where: { status: "APPROVED", saleType: "AUCTION", auctionEnd: { gt: new Date() } },
    take: 4,
    orderBy: { auctionEnd: "asc" },
    include: { bids: { orderBy: { amount: "desc" }, take: 1 } },
  });
  return { featured, auctions };
}

export default async function Home() {
  const { featured, auctions } = await getData();

  return (
    <div className="bg-gray-50">
      {/* TOP BAR */}
      <div className="bg-antique-950 text-cream text-xs py-2">
        <div className="container mx-auto px-4 flex justify-between items-center">
          <div className="flex items-center gap-2"><MapPin className="w-3 h-3" /> Peshawar, Pakistan</div>
          <div className="flex gap-4">
            <Link href="/help" className="hover:text-gold-400">Help Center</Link>
            <Link href="/sell" className="hover:text-gold-400">Sell on Antique Bazaar</Link>
          </div>
        </div>
      </div>

      {/* SEARCH HEADER */}
      <div className="bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm">
        <div className="container mx-auto px-4 py-4">
          <div className="flex items-center gap-6">
            <Link href="/" className="flex items-center gap-2 shrink-0">
              <div className="w-10 h-10 bg-gradient-to-br from-antique-700 to-gold-500 rounded-lg flex items-center justify-center">
                <Gavel className="w-6 h-6 text-white" />
              </div>
              <span className="font-serif font-bold text-xl text-antique-900 hidden md:block">Antique Bazaar</span>
            </Link>

            <div className="flex-1 max-w-3xl">
              <form action="/listings" className="flex">
                <div className="relative flex-1">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
                  <input name="q" type="text" placeholder="Search antiques, coins, paintings, watches..." className="w-full pl-10 pr-4 py-3 border-2 border-antique-600 rounded-l-lg focus:outline-none text-sm" />
                </div>
                <button type="submit" className="bg-antique-700 text-white px-8 rounded-r-lg font-semibold hover:bg-antique-800 transition">Search</button>
              </form>
              <div className="flex gap-3 mt-2 text-xs text-gray-500">
                <span className="font-semibold">Popular:</span>
                {["Mughal", "Victorian", "Coins", "Watches", "Rugs"].map(t => (
                  <Link key={t} href={`/listings?q=${t}`} className="hover:text-antique-700">{t}</Link>
                ))}
              </div>
            </div>

            <div className="hidden lg:flex items-center gap-4 text-sm">
              <Link href="/login" className="font-semibold text-antique-700 hover:text-antique-900">Sign In</Link>
              <Link href="/signup" className="btn-primary text-sm py-2 px-4">Join Free</Link>
            </div>
          </div>
        </div>
      </div>

      {/* MAIN 3-COLUMN LAYOUT */}
      <div className="container mx-auto px-4 py-6">
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          {/* LEFT: Categories */}
          <aside className="lg:col-span-3 bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div className="bg-antique-700 text-white px-4 py-3 font-bold text-sm">All Categories</div>
            <ul className="divide-y divide-gray-100">
              {CATEGORIES.map(cat => (
                <li key={cat.slug}>
                  <Link href={`/listings?category=${cat.slug}`} className="flex items-center justify-between px-4 py-3 hover:bg-antique-50 transition text-sm">
                    <span>{cat.name}</span>
                    <ArrowRight className="w-4 h-4 text-gray-400" />
                  </Link>
                </li>
              ))}
            </ul>
            <div className="p-4 bg-antique-50">
              <Link href="/listings" className="text-antique-700 font-semibold text-sm hover:underline">View All →</Link>
            </div>
          </aside>

          {/* CENTER: Hero + Featured */}
          <div className="lg:col-span-6 space-y-6">
            <div className="relative bg-gradient-to-br from-antique-900 via-antique-800 to-antique-700 rounded-lg overflow-hidden h-72 flex items-center">
              <div className="absolute inset-0 opacity-20" style={{backgroundImage: "url('https://images.unsplash.com/photo-1523528283115-9bf9b1699245?w=1200')", backgroundSize: "cover", backgroundPosition: "center"}}></div>
              <div className="relative z-10 px-8">
                <span className="inline-block bg-gold-500 text-antique-950 text-xs font-bold px-3 py-1 rounded mb-3">✨ VERIFIED ANTIQUES</span>
                <h1 className="font-serif text-4xl font-bold text-white mb-3">Discover <span className="text-gold-400">Timeless</span> Treasures</h1>
                <p className="text-antique-200 mb-5 max-w-md">Buy & sell authentic antiques with confidence. Escrow protected.</p>
                <Link href="/listings" className="inline-flex items-center gap-2 bg-gold-500 text-antique-950 px-6 py-3 rounded-lg font-bold hover:bg-gold-400 transition">Shop Now <ArrowRight className="w-5 h-5" /></Link>
              </div>
            </div>

            <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
              <div className="flex items-center justify-between mb-4">
                <h2 className="font-bold text-lg">Featured Antiques</h2>
                <Link href="/listings" className="text-sm text-antique-700 hover:underline flex items-center gap-1">View All <ArrowRight className="w-4 h-4" /></Link>
              </div>
              <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
                {featured.slice(0, 6).map(l => {
                  const imgs = JSON.parse(l.images);
                  return (
                    <Link key={l.id} href={`/listings/${l.id}`} className="group border border-gray-100 rounded-lg overflow-hidden hover:shadow-md transition">
                      <div className="relative h-36 overflow-hidden">
                        <img src={imgs[0]} alt={l.title} className="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                        <div className="absolute top-2 right-2"><WishlistButton listingId={l.id} size="sm" /></div>
                      </div>
                      <div className="p-3">
                        <h3 className="text-sm font-semibold line-clamp-1">{l.title}</h3>
                        <p className="text-xs text-gray-500 mt-0.5">{l.seller.name}</p>
                        <p className="font-bold text-antique-900 mt-1">{l.price ? formatPrice(l.price) : "Auction"}</p>
                      </div>
                    </Link>
                  );
                })}
              </div>
            </div>
          </div>

          {/* RIGHT: Auctions + Trust */}
          <div className="lg:col-span-3 space-y-6">
            <div className="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
              <div className="bg-red-600 text-white px-4 py-3 font-bold text-sm flex items-center gap-2">
                <span className="w-2 h-2 bg-white rounded-full animate-pulse"></span> LIVE AUCTIONS
