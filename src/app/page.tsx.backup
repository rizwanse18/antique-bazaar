              <div className="divide-y divide-gray-100">
                {auctions.length === 0 ? (
                  <p className="p-4 text-sm text-gray-500">No live auctions</p>
                ) : auctions.map(a => {
                  const imgs = JSON.parse(a.images);
                  const currentBid = a.bids[0]?.amount || a.startingBid || 0;
                  return (
                    <Link key={a.id} href={`/listings/${a.id}`} className="flex gap-3 p-3 hover:bg-antique-50 transition">
                      <img src={imgs[0]} alt={a.title} className="w-16 h-16 object-cover rounded" />
                      <div className="flex-1 min-w-0">
                        <p className="text-xs font-semibold line-clamp-1">{a.title}</p>
                        <p className="text-xs text-red-600 font-bold mt-1">{formatPrice(currentBid)}</p>
                        <AuctionCountdown endTime={a.auctionEnd!} compact />
                      </div>
                    </Link>
                  );
                })}
              </div>
              <Link href="/auctions" className="block text-center py-3 text-sm text-antique-700 font-semibold hover:bg-antique-50">View All Auctions →</Link>
            </div>

            <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-4 space-y-3">
              {[
                { icon: BadgeCheck, title: "Expert Verified", desc: "Every antique authenticated" },
                { icon: Shield, title: "Escrow Protected", desc: "Money held until delivery" },
                { icon: Truck, title: "Insured Shipping", desc: "Worldwide secure delivery" },
              ].map((b, i) => (
                <div key={i} className="flex items-center gap-3">
                  <div className="w-8 h-8 bg-antique-100 rounded-lg flex items-center justify-center shrink-0">
                    <b.icon className="w-4 h-4 text-antique-700" />
                  </div>
                  <div>
                    <p className="text-xs font-semibold">{b.title}</p>
                    <p className="text-xs text-gray-500">{b.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* BOTTOM: More Treasures */}
        {featured.length > 6 && (
          <div className="mt-6 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
            <div className="flex items-center justify-between mb-4">
              <h2 className="font-bold text-lg flex items-center gap-2"><TrendingUp className="w-5 h-5" /> More Treasures</h2>
              <Link href="/listings" className="text-sm text-antique-700 hover:underline">View All →</Link>
            </div>
            <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {featured.slice(6, 12).map(l => {
                const imgs = JSON.parse(l.images);
                return (
                  <Link key={l.id} href={`/listings/${l.id}`} className="group border border-gray-100 rounded-lg overflow-hidden hover:shadow-md transition">
                    <div className="relative h-32 overflow-hidden">
                      <img src={imgs[0]} alt={l.title} className="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    </div>
                    <div className="p-2">
                      <h3 className="text-xs font-semibold line-clamp-1">{l.title}</h3>
                      <p className="text-xs font-bold text-antique-900 mt-1">{l.price ? formatPrice(l.price) : "Auction"}</p>
